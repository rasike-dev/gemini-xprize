// LedgerPilot AI - data model.
// Multi-tenant: every tenant-scoped table carries tenantId and is protected by
// Postgres Row-Level Security (see migrations/*_rls). The app sets
// `app.tenant_id` per transaction; RLS is the real isolation boundary.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  STAFF
}

enum PlanTier {
  STARTER
  GROWTH
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingProvider {
  PAYHERE
  STRIPE
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum AgentType {
  INQUIRY
  QUOTE
  INVOICE
  PAYMENT_FOLLOWUP
  CASHFLOW
  COMPLIANCE
  SUPPORT
}

enum AgentRunStatus {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum IntakeChannel {
  WHATSAPP
  EMAIL
  WEB
}

model Tenant {
  id            String   @id @default(uuid())
  clerkOrgId    String   @unique
  name          String
  currency      String   @default("LKR")
  countryCode   String   @default("LK")
  vatNumber     String?
  autoSend      Boolean  @default(false)

  /// Per-period usage counters, reset by the daily scheduler when the period rolls.
  /// tokenBudget is derived from the plan tier on each reset.
  tokenBudget      BigInt   @default(2000000)
  tokensUsed       BigInt   @default(0)
  agentRunsUsed    Int      @default(0)
  usagePeriodStart DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  customers    Customer[]
  quotes       Quote[]
  invoices     Invoice[]
  payments     Payment[]
  reminders    Reminder[]
  agentRuns    AgentRun[]
  inquiries    Inquiry[]
  auditLogs    AuditLog[]
  subscription Subscription?

  @@map("tenants")
}

model User {
  id          String   @id @default(uuid())
  tenantId    String
  clerkUserId String   @unique
  email       String
  name        String?
  role        UserRole @default(STAFF)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

model Subscription {
  id       String             @id @default(uuid())
  tenantId String             @unique
  plan     PlanTier           @default(STARTER)
  status   SubscriptionStatus @default(TRIALING)
  provider BillingProvider    @default(PAYHERE)
  interval BillingInterval    @default(MONTHLY)

  externalCustomerId String?
  externalSubId      String?

  /// End of the paid period. Access is denied once this passes (see EntitlementsService).
  currentPeriodEnd DateTime?
  /// End of the free trial. Only meaningful while status is TRIALING.
  trialEndsAt      DateTime?
  /// When the gateway will next charge, for recurring subscriptions only.
  nextBillingAt    DateTime?
  /// Set when the customer cancels. Access continues until currentPeriodEnd,
  /// which is the period they already paid for; status stays ACTIVE until then.
  cancelAtPeriodEnd Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments BillingPayment[]

  @@index([externalSubId])
  @@map("subscriptions")
}

/// Payments LedgerPilot received from a tenant for its own subscription.
/// Distinct from `Payment`, which is money the tenant received from its customers.
model BillingPayment {
  id             String          @id @default(uuid())
  tenantId       String
  subscriptionId String
  provider       BillingProvider @default(PAYHERE)
  /// Our generated reference, sent to the gateway as order_id. Unique per tenant.
  orderId        String
  /// Gateway's own payment reference, once known.
  externalRef    String?
  plan           PlanTier
  interval       BillingInterval
  amountMinor    Int
  currency       String          @default("LKR")
  /// Raw gateway status code, kept for reconciliation and dispute handling.
  statusCode     String
  succeeded      Boolean         @default(false)
  /// Which charge in a recurring series this was. 1 for one-time payments.
  installment    Int             @default(1)
  periodStart    DateTime?
  periodEnd      DateTime?
  createdAt      DateTime        @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orderId])
  @@index([tenantId])
  @@map("billing_payments")
}

/// Durable audit trail. Complements the AgentRun log, which covers AI decisions
/// only; this records human and system actions (billing, approvals, sends).
model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  action    String
  /// Clerk user id, or a system identifier such as "webhook:payhere".
  actor     String
  metaJson  Json     @default("{}")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model Customer {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  phone       String?
  email       String?
  notes       String?
  lastContact DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotes   Quote[]
  invoices Invoice[]
  inquiries Inquiry[]

  @@index([tenantId])
  @@map("customers")
}

model Inquiry {
  id             String        @id @default(uuid())
  tenantId       String
  customerId     String?
  channel        IntakeChannel
  fromIdentifier String
  fromName       String?
  subject        String?
  body           String
  idempotencyKey String
  receivedAt     DateTime      @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
  agentRuns AgentRun[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@map("inquiries")
}

model Quote {
  id         String      @id @default(uuid())
  tenantId   String
  customerId String
  number     String
  status     QuoteStatus @default(DRAFT)
  currency   String      @default("LKR")
  subtotalMinor Int       @default(0)
  taxMinor      Int       @default(0)
  totalMinor    Int       @default(0)
  notes      String?
  validUntil DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id])
  lines    QuoteLine[]
  invoice  Invoice?

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("quotes")
}

model QuoteLine {
  id             String @id @default(uuid())
  tenantId       String
  quoteId        String
  description    String
  quantity       Float
  unitPriceMinor Int
  taxRatePct     Float  @default(0)
  totalMinor     Int

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([quoteId])
  @@map("quote_lines")
}

model Invoice {
  id         String        @id @default(uuid())
  tenantId   String
  customerId String
  quoteId    String?       @unique
  number     String
  status     InvoiceStatus @default(DRAFT)
  currency   String        @default("LKR")
  subtotalMinor Int        @default(0)
  taxMinor      Int        @default(0)
  totalMinor    Int        @default(0)
  paidMinor     Int        @default(0)
  dueDate    DateTime?
  pdfUrl     String?
  shareToken String        @unique @default(uuid())
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer      @relation(fields: [customerId], references: [id])
  quote     Quote?        @relation(fields: [quoteId], references: [id])
  lines     InvoiceLine[]
  payments  Payment[]
  reminders Reminder[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id             String @id @default(uuid())
  tenantId       String
  invoiceId      String
  description    String
  quantity       Float
  unitPriceMinor Int
  taxRatePct     Float  @default(0)
  totalMinor     Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id          String   @id @default(uuid())
  tenantId    String
  invoiceId   String
  amountMinor Int
  method      String   @default("manual")
  reference   String?
  paidAt      DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("payments")
}

model Reminder {
  id          String   @id @default(uuid())
  tenantId    String
  invoiceId   String
  channel     String
  subject     String?
  message     String
  tone        String   @default("FRIENDLY")
  sentAt      DateTime?
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("reminders")
}

/// Central AI audit table. Every AI decision is a row here: input, output,
/// decision, confidence, model, tokens, cost, and human-approval status.
model AgentRun {
  id            String         @id @default(uuid())
  tenantId      String
  agentType     AgentType
  status        AgentRunStatus @default(PENDING)
  inquiryId     String?
  subjectType   String?        // e.g. "invoice", "quote"
  subjectId     String?
  inputJson     Json
  outputJson    Json?
  decision      String?
  confidence    Float?
  humanApproved Boolean        @default(false)
  approvedBy    String?
  geminiModel   String?
  tokensUsed    Int            @default(0)
  costEstimate  Float          @default(0)
  error         String?
  idempotencyKey String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inquiry Inquiry? @relation(fields: [inquiryId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([agentType])
  @@index([status])
  @@map("agent_runs")
}
