# Staging lives in its own GCP project, so its database and secrets are entirely
# separate from production. Nothing done here can reach a real customer's books.
#
#   terraform workspace select staging
#   terraform apply -var-file=staging.tfvars

project_id  = "bizopsmate-staging"
region      = "asia-south1"
environment = "staging"
db_tier     = "db-f1-micro"

api_image    = "asia-south1-docker.pkg.dev/bizopsmate-staging/bizopsmate/api:latest"
worker_image = "asia-south1-docker.pkg.dev/bizopsmate-staging/bizopsmate/worker:latest"
web_image    = "asia-south1-docker.pkg.dev/bizopsmate-staging/bizopsmate/web:latest"

web_domain = "https://staging.bizopsmateai.com"
api_domain = "https://api-staging.bizopsmateai.com"

# Cold starts are fine here, and scale-to-zero keeps staging close to free.
min_instances = 0

alert_email           = "alerts@bizopsmateai.com"
clerk_publishable_key = "pk_test_replace_me"

payhere_merchant_id = "1234567"
payhere_sandbox     = true
