{
  "name": "ledgerpilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "LedgerPilot AI - AI finance & operations agent for small businesses",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:e2e",
    "test:coverage": "pnpm --filter @ledgerpilot/api test:coverage && pnpm --filter @ledgerpilot/web test:coverage",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @ledgerpilot/db generate",
    "db:migrate": "pnpm --filter @ledgerpilot/db migrate",
    "db:seed": "pnpm --filter @ledgerpilot/db seed",
    "deploy:images": "./infra/scripts/build-and-push-images.sh",
    "deploy:infra": "./infra/scripts/deploy-terraform.sh",
    "deploy:secrets": "./infra/scripts/populate-secrets.sh",
    "deploy:db": "./infra/scripts/cloudsql-migrate-seed.sh",
    "deploy:verify": "./infra/scripts/verify-cloud-run.sh",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "vitest": "^2.1.8",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@nestjs/core",
      "protobufjs"
    ]
  }
}
