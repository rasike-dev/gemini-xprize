{
  "name": "ledgerpilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "LedgerPilot AI - AI finance & operations agent for small businesses",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @ledgerpilot/db generate",
    "db:migrate": "pnpm --filter @ledgerpilot/db migrate",
    "db:seed": "pnpm --filter @ledgerpilot/db seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@nestjs/core",
      "protobufjs"
    ]
  }
}
