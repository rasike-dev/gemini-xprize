{
  "name": "@ledgerpilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "node ../../scripts/with-root-env.mjs node node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start": "node ../../scripts/with-root-env.mjs node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "echo \"(lint) api\""
  },
  "dependencies": {
    "@clerk/backend": "^1.21.0",
    "@google-cloud/tasks": "^5.5.0",
    "@ledgerpilot/ai": "workspace:*",
    "@ledgerpilot/db": "workspace:*",
    "@ledgerpilot/notify": "workspace:*",
    "@ledgerpilot/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.3.0",
    "@sentry/node": "^8.43.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pdfkit": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^17.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.9",
    "@vitest/coverage-v8": "^2.1.9",
    "svix": "^1.95.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
