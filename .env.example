# ==============================================================================
# BizOpsMate AI - environment template. Copy to .env and fill in.
# In production these come from Google Secret Manager, never committed.
# ==============================================================================

# --- Core ---
NODE_ENV=development
GCP_PROJECT_ID=bizopsmate-dev
GCP_REGION=asia-south1

# --- Database (Cloud SQL Postgres) ---
# Local dev uses a direct connection string; Cloud Run uses the Cloud SQL connector.
DATABASE_URL=postgresql://ledgerpilot:ledgerpilot@localhost:5432/ledgerpilot?schema=public
# App role used at runtime (RLS-enforced, NOT a superuser / NOT BYPASSRLS).
DATABASE_APP_URL=postgresql://ledgerpilot_app:ledgerpilot_app@localhost:5432/ledgerpilot?schema=public

# --- Clerk (auth) ---
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWT_ISSUER=https://your-app.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- Gemini / Vertex AI ---
# Either use a Gemini API key (fastest) or Vertex AI with ADC.
GEMINI_API_KEY=
VERTEX_PROJECT_ID=bizopsmate-dev
VERTEX_LOCATION=asia-south1
GEMINI_MODEL_FAST=gemini-2.0-flash
GEMINI_MODEL_PRO=gemini-2.0-pro

# --- Cloud Tasks (async agent queue) ---
TASKS_QUEUE=agent-runs
TASKS_LOCATION=asia-south1
WORKER_URL=http://localhost:8081
WORKER_SERVICE_ACCOUNT=worker@bizopsmate-dev.iam.gserviceaccount.com
# Local dev: run worker inline instead of via Cloud Tasks.
TASKS_DRIVER=inline

# --- Cloud Storage (invoice PDFs) ---
STORAGE_BUCKET=bizopsmate-documents

# --- Intake webhook ---
INTAKE_HMAC_SECRET=dev-intake-secret-change-me

# --- Billing ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
# Optional; annual falls back to the monthly price when unset.
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_ANNUAL=
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
# LITE (default) = one-time payments only. PLUS = PayHere's Recurring API, so
# subscriptions renew on their own. Only switch after upgrading in PayHere.
PAYHERE_MERCHANT_PLAN=LITE
# Subscription Manager API credentials, for cancelling and retrying recurring
# charges. Create a Business App in PayHere with the Subscription permission.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

# --- Email (transactional) ---
RESEND_API_KEY=
EMAIL_FROM="BizOpsMate AI <billing@bizopsmateai.com>"

# --- Observability ---
SENTRY_DSN=

# --- Service URLs ---
API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=https://bizopsmateai.com

# --- Business identity (footer + legal pages; required for PayHere approval) ---
NEXT_PUBLIC_BUSINESS_NAME=BizOpsMate AI
NEXT_PUBLIC_BUSINESS_EMAIL=hello@bizopsmateai.com
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_REG_NO=
NEXT_PUBLIC_LEGAL_UPDATED=25 July 2026

# --- Cost / safety guardrails ---
TENANT_MONTHLY_TOKEN_BUDGET=2000000
AGENT_AUTOSEND_CONFIDENCE_THRESHOLD=0.8
